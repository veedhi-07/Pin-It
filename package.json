{
  "name": "pinboard",
  "private": true,
  "version": "0.1.0",
  "description": "Pinterest-style pins, boards, and chat monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @pinboard/web",
    "dev:api": "npm run dev -w @pinboard/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate -w @pinboard/api"
  },
  "engines": {
    "node": ">=20"
  }
}
